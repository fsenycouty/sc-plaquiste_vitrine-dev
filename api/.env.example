PORT=4000
# Origine autorisée par CORS (URL du site)
CORS_ORIGIN=http://localhost:3000
# Connexion Neon (secret)
DATABASE_URL=postgresql://utilisateur:motdepasse@hote/base?sslmode=require
# Resend (secret)
RESEND_API_KEY=re_xxxxxxxxxxxx
MAIL_FROM=site@envoi.sondomaine.fr
# Adresse qui reçoit les demandes ; elle peut être la boîte Gmail de l'artisan.
MAIL_TO=contact@sondomaine.fr
# Cloudinary — phase 2 (nom du cloud public, clés API secrètes)
CLOUDINARY_CLOUD_NAME=nom-du-cloud
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=xxxxxxxxxxxx
# Auth — phase 2 (secret)
JWT_SECRET=remplacer_par_une_cle_aleatoire_longue